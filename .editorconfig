# https://editorconfig.org
# Unreal's own source uses tabs; we match it so engine-adjacent code stays consistent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Unreal C++ / C#
[*.{h,hpp,inl,c,cpp,cs}]
indent_style = tab
indent_size = 4
max_line_length = 120

# Unreal Build Tool scripts
[*.{Build,Target}.cs]
indent_style = tab
indent_size = 4

# Unreal config files — the engine rewrites these; keep it simple.
[*.ini]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[*.{json,uproject,uplugin}]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false  # two trailing spaces = hard line break

[*.py]
indent_style = space
indent_size = 4

[*.{sh,bash}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.{bat,cmd,ps1}]
end_of_line = crlf
