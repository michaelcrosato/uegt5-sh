###############################################################################
# Git attributes for an Unreal Engine 5 project
#
# Two jobs:
#   1. Route every binary asset through Git LFS so the repo stays clonable.
#   2. Pin line endings so UE, MSVC and the shell tools all agree.
#
# After editing this file, existing files are NOT retroactively migrated.
# Use `git lfs migrate import --include="<pattern>" --everything` for that.
###############################################################################

# Normalise text in the repo (LF), check out native (CRLF on Windows).
* text=auto

#------------------------------------------------------------------------------
# Unreal Engine assets  --  ALWAYS LFS, never diffed, never merged
#------------------------------------------------------------------------------
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.uptnl   filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text
*.udk     filter=lfs diff=lfs merge=lfs -text
*.uplugin text
*.uproject text

# File locking. Off by default: `lockable` makes assets read-only on checkout,
# which breaks saving in the editor unless the Git source-control plugin is
# configured with "Use Git LFS File Locking". Turn these on when a second
# person joins the project -- see docs/engineering/source-control.md.
# *.uasset lockable
# *.umap   lockable

#------------------------------------------------------------------------------
# Source art & DCC files
#------------------------------------------------------------------------------
*.blend   filter=lfs diff=lfs merge=lfs -text
